{
  "name": "dronepvo-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute dronepvo --local --file=schema.sql",
    "db:migrate:remote": "wrangler d1 execute dronepvo --remote --file=schema.sql",
    "bundle": "esbuild src/index.js --bundle --format=esm --platform=neutral --target=esnext --outfile=dist/worker-bundled.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260804.1": true
  }
}
